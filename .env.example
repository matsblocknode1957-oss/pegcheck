# ── Hardhat / Deployment ──────────────────────────────────────────────────────

# Alchemy RPC URL for Ethereum Sepolia
# Get one at https://dashboard.alchemy.com
ALCHEMY_RPC_URL=https://eth-sepolia.g.alchemy.com/v2/YOUR_KEY

# Deployer wallet private key (no 0x prefix needed)
# Never commit your real key — this file is safe to commit, .env is not
DEPLOYER_PRIVATE_KEY=your_private_key_here

# ── StableGuard constructor args ──────────────────────────────────────────────

# CCIP destination chain selector (default: Avalanche Fuji = 14767482510784806043)
# Full list: https://docs.chain.link/ccip/supported-networks
DESTINATION_CHAIN_SELECTOR=14767482510784806043

# StableGuardReceiver address on the destination chain (deploy that contract first)
CCIP_RECEIVER_ADDRESS=0x0000000000000000000000000000000000000000

# Uniswap V3 USDC/USDT pool on Sepolia (set to zero address to skip DEX cross-check)
UNISWAP_POOL_ADDRESS=0x0000000000000000000000000000000000000000

# ── Next.js / Supabase (existing) ─────────────────────────────────────────────
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
SEPOLIA_RPC_URL=
